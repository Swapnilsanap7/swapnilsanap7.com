NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=GTM-5S63WMNJ
NEXT_PUBLIC_GA_ID=
# Use "direct" until GA4 tags are configured and published in GTM.
# Switch to "gtm" before enabling GA4 event tags in the GTM container.
NEXT_PUBLIC_ANALYTICS_MODE=direct
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

APPLE_SMTP_USER=
APPLE_SMTP_PASS=
MAIL_FROM=

# Recommended for durable contact-form rate limiting in serverless deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Central Project Access Hub — Firebase web config (public by design)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=swapnilsanap7-e2397.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=swapnilsanap7-e2397
NEXT_PUBLIC_FIREBASE_APP_ID=1:539823467047:web:02952acef211302a05fc02

# Firebase Admin service account — server-only, never use NEXT_PUBLIC_ names.
FIREBASE_PROJECT_ID=swapnilsanap7-e2397
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n characters between lines in Vercel.
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_ID=
# Local development only: absolute path to an ignored service-account JSON key.
# Leave empty in Vercel; use FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY there.
GOOGLE_APPLICATION_CREDENTIALS=

# Both values must exactly match the one verified Firebase Authentication user.
ACCESS_HUB_ADMIN_UID=
ACCESS_HUB_ADMIN_EMAIL=
# Used only to create a non-reversible requester IP fingerprint.
ACCESS_HUB_IP_SALT=
ACCESS_HUB_MAIL_FROM=hello@swapnilsanap7.com
RESEND_API_KEY=
# Comma-separated origins allowed to submit to the shared public endpoint.
ACCESS_HUB_ALLOWED_ORIGINS=https://safe-spend-three.vercel.app,https://splitexpense-web.vercel.app

# Optional project-specific provisioning webhooks. If omitted, approval sends
# the project's configured demo URL. The webhook receives requestId, name,
# email, and expiresAt, and returns { type, url, instructions, externalId }.
SAFE_SPEND_ACCESS_WEBHOOK_URL=
SAFE_SPEND_ACCESS_WEBHOOK_SECRET=
SPLITXPENSE_ACCESS_WEBHOOK_URL=
SPLITXPENSE_ACCESS_WEBHOOK_SECRET=
