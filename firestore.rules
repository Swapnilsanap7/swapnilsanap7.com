rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: accessRequests
    // Document ID: server-generated Firestore ID
    // Fields: requester PII, request details, workflow state, and timestamps.
    // All documents are server-owned. No browser SDK operation is valid.
    // The full design and attack review is in FIRESTORE_RULES_AUDIT.md.
    // ===============================================================

    // The Access Hub is server-only. Browsers never read or write Firestore,
    // including authenticated browsers. Next.js uses a least-privilege service
    // account and performs all validation and authorization server-side.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
