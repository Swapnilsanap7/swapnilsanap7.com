/**
 * Project Data Structure for Reusable Project Detail Component
 * 
 * This defines the standard structure for project data that can be used
 * with the ProjectDetail component to create consistent project showcase pages.
 */

/**
 * @typedef {Object} ProjectData
 * @property {string} slug - URL slug for the project
 * @property {string} title - Project name (displayed as large hero title)
 * @property {string} subtitle - Primary tagline (medium opacity subtitle)
 * @property {string} description - Short description for cards/previews
 * @property {'browser'|'mobile'} [displayType] - MANUAL mockup selection: 'browser' for laptop/web mockups, 'mobile' for phone mockups (defaults to mobile if not specified)
 * @property {string} demo - Live demo URL
 * @property {string} github - GitHub repository URL
 * @property {string} image - Main project image path
 * @property {string} fullDescription - Detailed project description
 * @property {string[]} techStack - Array of technology names
 * @property {string} imageSrc - Legacy image source (for compatibility)
 * @property {string} githubLink - Legacy GitHub link (for compatibility)
 * @property {string} liveDemoLink - Legacy demo link (for compatibility)
 * @property {HeroData} hero - Hero section specific data
 * @property {Feature[]} features - Array of key features
 * @property {TechStackItem[]} techStackDetailed - Detailed tech stack with icons
 * @property {string[]} gallery - Array of image paths for gallery
 * @property {CaseStudy} caseStudy - Challenge and solution information
 */

/**
 * @typedef {Object} HeroData
 * @property {string} tagline - Primary subtitle displayed in hero
 * @property {string} mainImage - Main hero image (mobile mockup style)
 */

/**
 * @typedef {Object} Feature
 * @property {string} icon - Emoji or icon character
 * @property {string} title - Feature name
 * @property {string} description - Brief feature description
 */

/**
 * @typedef {Object} TechStackItem
 * @property {string} name - Technology name
 * @property {string} [icon] - Path to technology icon
 * @property {string} [description] - Optional description
 */

/**
 * @typedef {Object} CaseStudy
 * @property {string} challenge - Problem description
 * @property {string} solution - Solution description
 */

